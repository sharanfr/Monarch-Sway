{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "type": "file",
    "color": {
      "1": "38;2;137;180;250"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },

  "display": {
    "separator": " ",
    "color": {
      "title": "38;2;137;180;250"
    }
  },

  "modules": [
    "break",

    {
      "type": "title",
      "format": "{user-name} @ {host-name}"
    },

{
  "type": "custom",
  "format": "\u001b[38;2;180;210;255mMonarch-Sway • v1.0"
},
    "break",

    {
      "type": "custom",
      "format": "\u001b[38;2;137;180;250m╭─  Hardware"
    },
    {
      "type": "host",
      "key": "\u001b[38;2;180;210;255m├─  Host"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;180;210;255m├─  CPU "
    },
    {
      "type": "gpu",
      "key": "\u001b[38;2;180;210;255m├─  GPU "
    },
    {
      "type": "disk",
      "key": "\u001b[38;2;180;210;255m├─  Disk"
    },
    {
      "type": "memory",
      "key": "\u001b[38;2;180;210;255m├─  Mem "
    },
    {
      "type": "battery",
      "key": "\u001b[38;2;180;210;255m╰─  Battery"
    },

    "break",

    {
      "type": "custom",
      "format": "\u001b[38;2;137;180;250m╭─  Software"
    },
    {
      "type": "os",
      "key": "\u001b[38;2;180;210;255m├─  OS  "
    },
    {
      "type": "kernel",
      "key": "\u001b[38;2;180;210;255m├─  Kern"
    },
    {
      "type": "packages",
      "key": "\u001b[38;2;180;210;255m├─ 󰏖 Pkgs"
    },
    {
      "type": "shell",
      "key": "\u001b[38;2;180;210;255m╰─  Shell"
    },

    "break",

    {
      "type": "custom",
      "format": "\u001b[38;2;137;180;250m╭─  Desktop"
    },
    {
      "type": "wm",
      "key": "\u001b[38;2;180;210;255m├─  WM  "
    },
    {
      "type": "terminal",
      "key": "\u001b[38;2;180;210;255m╰─  Term"
    },

    "break",

    {
      "type": "custom",
      "format": "\u001b[38;2;137;180;250m╭─  Runtime"
    },
    {
      "type": "uptime",
      "key": "\u001b[38;2;180;210;255m╰─ 󰅐 Up"
    },

    "break",

    {
      "type": "colors",
      "paddingLeft": 0,
      "symbol": "star",
      "block": {
        "range": [4, 7]
      }
    },

    "break"
  ]
}
