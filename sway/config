### ------------------------------------
### MATERIAL EXPRESSIVE 3 - SWAY CONFIG
### ------------------------------------

set $mod Mod4
set $term foot
set $menu wofi --show drun --width 700 --height 450 --prompt "Launch"
set $lock swaylock -c 000000

### Environment / Portal Fixes
#exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK
exec_always pkill -f gnome-wallpaper-sync.sh; ~/.config/sway/scripts/gnome-wallpaper-sync.sh
exec_always sh -c 'pkill swaybg; sleep 1; WALL=$(cat ~/.config/sway/current_wallpaper 2>/dev/null); [ -f "$WALL" ] && swaybg -i "$WALL" -m fill'
exec mako
 exec_always pkill swayidle; swayidle -w \
 timeout 300 '~/.config/sway/scripts/lockscreen.sh' \
 timeout 600 'swaymsg "output * dpms off"' \
 resume 'swaymsg "output * dpms on"' \
 timeout 1800 'systemctl suspend' \
 before-sleep '~/.config/sway/scripts/lockscreen.sh'
### Clipboard daemon
exec_always pkill cliphist; wl-paste --type text --watch cliphist store

## Appearance
gaps inner 8
gaps outer 8
smart_gaps on
default_border pixel 2

client.focused   #89b4fa #89b4fa #1e1e2e #89b4fa #89b4fa
client.unfocused #313244 #313244 #cdd6f4 #313244 #313244

### Terminal / launcher
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu

### Window controls
bindsym Mod1+F4 kill
bindsym $mod+l exec ~/.config/sway/scripts/lockscreen.sh
bindsym $mod+r exec swaymsg reload

### Files / Browser
bindsym $mod+e exec nautilus
bindsym $mod+Shift+b exec brave-browser

### Network / Bluetooth
bindsym $mod+n exec nm-connection-editor
bindsym $mod+Shift+n exec blueman-manager

### Clipboard History
bindsym $mod+v exec sh -c 'cliphist list | wofi --dmenu --prompt "Clipboard" | cliphist decode | wl-copy'

### Screenshot / Recording

# Region screenshot
bindsym Print exec sh -c 'f=~/Pictures/$(date +%Y-%m-%d_%H-%M-%S).png; grim -g "$(slurp)" "$f" && wl-copy < "$f" && notify-send "Screenshot Taken" "Saved to Pictures + copied to clipboard"'
# Fullscreen screenshot
bindsym Shift+Print exec sh -c 'f=~/Pictures/$(date +%Y-%m-%d_%H-%M-%S).png; grim "$f" && wl-copy < "$f" && notify-send "Fullscreen Screenshot" "Saved to Pictures + copied to clipboard"'
# Start fullscreen recording
bindsym Ctrl+Print exec sh -c 'notify-send "Recording Started" "Screen recording in progress"; wf-recorder -f ~/Videos/recording-$(date +%s).mp4'
# Stop recording
bindsym Ctrl+Shift+Print exec sh -c 'pkill wf-recorder && notify-send "Recording Saved" "Screen recording stopped successfully"'
### Volume OSD
bindsym XF86AudioRaiseVolume exec ~/.config/sway/scripts/volume.sh up
bindsym XF86AudioLowerVolume exec ~/.config/sway/scripts/volume.sh down
bindsym XF86AudioMute exec ~/.config/sway/scripts/volume.sh mute

### Brightness OSD
bindsym XF86MonBrightnessUp exec ~/.config/sway/scripts/brightness.sh up
bindsym XF86MonBrightnessDown exec ~/.config/sway/scripts/brightness.sh down

### Do Not Disturb
bindsym $mod+F4 exec ~/.config/sway/scripts/toggle-dnd.sh

### Power Profiles + Wallpapers + Settings
### Power Profiles + Wallpapers + Settings
bindsym $mod+Escape exec sh -c '\
choice=$(printf "Power Saver\nBalanced\nPerformance\nWallpapers\nBluetooth Settings\nAudio Settings\nWifi Settings" \
| wofi --dmenu --prompt "System"); \
case "$choice" in \
"Power Saver") powerprofilesctl set power-saver ;; \
"Balanced") powerprofilesctl set balanced ;; \
"Performance") powerprofilesctl set performance ;; \
"Wallpapers") ~/.config/sway/scripts/wallpaper-picker.sh ;; \
"Bluetooth Settings") blueman-manager ;; \
"Audio Settings") pavucontrol ;; \
"Wifi Settings") nm-connection-editor ;; \
esac'
### System Power Menu
### System Power Menu
bindsym $mod+q exec sh -c '\
choice=$(printf "Lock\nLogout\nShutdown\nReboot" \
| wofi --dmenu --prompt "Power"); \
case "$choice" in \
"Lock") ~/.config/sway/scripts/lockscreen.sh ;; \
"Logout") swaymsg exit ;; \
"Shutdown") systemctl poweroff ;; \
"Reboot") systemctl reboot ;; \
esac'
### Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4

### Focus movement
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

### Resize mode
mode "resize" {
    bindsym Left resize shrink width 10 px
    bindsym Down resize grow height 10 px
    bindsym Up resize shrink height 10 px
    bindsym Right resize grow width 10 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Shift+r mode "resize"

### Floating rules
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [title="Open File"] floating enable
for_window [title="Save File"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

### Touchpad
input "type:touchpad" {
    tap enabled
    natural_scroll enabled
}

### Waybar
bar {
    swaybar_command waybar
}
