{
  "layer": "top",
  "position": "bottom",
  "height": 52,
  "spacing": 10,

  "modules-left": [
    "sway/workspaces",
    "sway/window"
  ],

  "modules-center": [
    "custom/clock"
  ],

  "modules-right": [
    "backlight",
    "pulseaudio",
    "network",
    "bluetooth",
    "custom/powerprofile",
    "battery",
    "tray"
  ],

  "custom/clock": {
    "exec": "~/.config/waybar/scripts/clock-status.sh",
    "interval": 1,
    "tooltip": false,
    "on-click": "xdg-open https://calendar.google.com"
  },

  "custom/powerprofile": {
    "exec": "~/.config/waybar/scripts/power-profile.sh",
    "interval": 1,
    "tooltip": false,
    "on-click": "~/.config/sway/scripts/perf-menu.sh"
  },

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },

  "sway/window": {
    "max-length": 40,
    "separate-outputs": false,
    "format": "{title}",
    "rewrite": {
      "": "Empty Window"
    }
  },

  "backlight": {
    "format": "BRT {percent}%",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTE",
    "scroll-step": 5,
    "tooltip": false,
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": "NET {essid}",
    "format-ethernet": "LAN",
    "format-disconnected": "OFF",
    "tooltip": false,
    "on-click": "~/.config/sway/scripts/network-menu.sh"
},	

  "bluetooth": {
    "format": "BT",
    "format-connected": "BT {device_alias}",
    "format-disabled": "--",
    "tooltip-format": "{device_alias}",
    "on-click": "blueman-manager"
  },

  "battery": {
    "format": "PWR {capacity}%",
    "format-charging": "CHG {capacity}%",
    "tooltip": false,
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  }
}
